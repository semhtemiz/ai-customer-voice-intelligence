# Relative paths resolve from the project root. No secret values here.
DATABASE_PATH=backend/data/reviews.db
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Optional: empty means deterministic rules summary, no remote call.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# NVIDIA Build: set LLM_PROVIDER=nvidia and put your key only in backend/.env.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Translation uses a separate model; availability and quotas depend on the provider.
NVIDIA_TRANSLATION_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_SECONDS=8
TRANSLATION_TIMEOUT_SECONDS=30
